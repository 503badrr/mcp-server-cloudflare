/**
 * Switch safety configuration. Production and staging environments are added only
 * after the corresponding Switch-owned resources and OAuth secrets are provisioned.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "src/workers-observability.app.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	"name": "switch-mcp-workers-observability-unprovisioned",
	"migrations": [
		{
			"new_sqlite_classes": ["UserDetails", "ObservabilityMCP"],
			"tag": "v1"
		},
		{
			"deleted_classes": ["UserDetails"],
			"tag": "v2"
		}
	],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.1
		}
	},
	"durable_objects": {
		"bindings": [
			{
				"class_name": "ObservabilityMCP",
				"name": "MCP_OBJECT"
			}
		]
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "REPLACE_WITH_SWITCH_KV_NAMESPACE_ID"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "REPLACE_WITH_SWITCH_VECTORIZE_INDEX"
		}
	],
	"vars": {
		"ENVIRONMENT": "development",
		"MCP_SERVER_NAME": "switch-workers-observability-unprovisioned",
		"MCP_SERVER_VERSION": "0.5.1"
	},
	"secrets": {
		"required": ["CLOUDFLARE_CLIENT_ID", "CLOUDFLARE_CLIENT_SECRET", "MCP_COOKIE_ENCRYPTION_KEY"]
	},
	"dev": {
		"port": 8976
	},
	"workers_dev": false,
	"preview_urls": false,
	"analytics_engine_datasets": [
		{
			"binding": "MCP_METRICS",
			"dataset": "REPLACE_WITH_SWITCH_ANALYTICS_ENGINE_DATASET"
		}
	]
}
